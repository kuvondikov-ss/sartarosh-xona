# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-your-token-here

# Ma'lumotlar bazasi fayli
DB_PATH=data/bot.db

# Mini app: server porti va tashqi https manzili (Railway / ngrok / cloudflared)
PORT=3000
WEBAPP_URL=
# Chat pastidagi mini app tugmasi nomi
MENU_BUTTON_TEXT=✂️ SartaroshXona

# Admin Telegram ID lar (vergul bilan). ID ni bilish: botga /myid yozing
ADMIN_IDS=

# Vaqt zonasi (daqiqada). Toshkent = UTC+5 = 300
TZ_OFFSET_MINUTES=300
